[configuration]

entry_symbol = "example_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
windows.x86_64.debug = "asdf.windows.template_debug.x86_64.dll"
windows.x86_64.release = "asdf.windows.template_release.x86_64.dll"

linux.x86_64.debug = "asdf.linux.template_debug.x86_64.so"
linux.x86_64.release = "asdf.linux.template_release.x86_64.so"